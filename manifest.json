{
  "manifest_version": 3,
  "name": "New Tab Dashboard",
  "version": "1.0.0",
  "description": "A new tab page with calendar, tasks, and notes — styled with Nord colors.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms"],
  "optional_host_permissions": ["*://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
